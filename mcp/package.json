{
  "name": "@antonytm/figma-mcp-server",
  "mcpName": "io.github.Antonytm/figma-mcp-server",
  "version": "0.2.0",
  "description": "MCP Server for Figma",
  "main": "./dist/bundle.js",
  "bin": {
    "@antonytm/figma-mcp-server": "./dist/bundle.js"
  },
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "bundle": "rollup -c",
    "start": "tsc && node dist/index.js",
    "dev": "npm run build && concurrently -n \"TSC,NODEMON\" -c \"blue,green\" \"tsc --watch\" \"nodemon\"",
    "inspector": "npx @modelcontextprotocol/inspector@latest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/mcp-adapters": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "esm": "^3.2.25",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.4",
    "nodemon": "^3.1.14",
    "rollup": "^4.63.2",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Antonytm/figma-mcp-server.git"
  }
}
